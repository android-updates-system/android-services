<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1A1A2E">

    <!-- شاشة العرض (الرقم الناتج) -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#16213E"
        android:gravity="end|center_vertical"
        android:padding="16dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- السجل المخفي (يظهر فقط عند التمرير) -->
    <EditText
        android:id="@+id/etLog"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#0D0D12"
        android:textColor="#33F366"
        android:textSize="10sp"
        android:gravity="top|start"
        android:focusable="false"
        android:clickable="false"
        android:scrollbars="vertical"
        android:typeface="monospace"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- صف الأزرار: 7 8 9 ÷ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="7"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="8"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="9"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="÷"
            android:textSize="18sp"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- صف الأزرار: 4 5 6 × -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="4"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="5"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="6"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnMul"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="×"
            android:textSize="18sp"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- صف الأزرار: 1 2 3 - -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="1"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="3"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="-"
            android:textSize="18sp"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- صف الأزرار: 0 . = + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="0"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="."
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnEquals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="="
            android:textSize="18sp"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+"
            android:textSize="18sp"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- صف أزرار إضافية (مسح ونسخ السجل) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="C"
            android:textSize="18sp"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📋"
            android:textSize="18sp"
            android:backgroundTint="#2D2D44"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
